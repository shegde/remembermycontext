{
  "manifest_version": 3,
  "name": "RememberMyContext",
  "version": "1.0.1",
  "description": "Never repeat your context across LLM apps. Store once, use everywhere.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://remembermycontext.com/*",
    "https://www.remembermycontext.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.anthropic.com/*",
    "https://gemini.google.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://meta.ai/*",
    "https://llama.meta.com/*",
    "https://mistral.ai/*",
    "https://chat.mistral.ai/*",
    "https://console.mistral.ai/*",
    "https://x.ai/*",
    "https://grok.x.ai/*",
    "https://deepseek.com/*",
    "https://platform.deepseek.com/*",
    "https://qwen.ai/*",
    "https://tongyi.aliyun.com/*",
    "https://kimi.moonshot.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.anthropic.com/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://meta.ai/*",
        "https://llama.meta.com/*",
        "https://mistral.ai/*",
        "https://chat.mistral.ai/*",
        "https://console.mistral.ai/*",
        "https://x.ai/*",
        "https://grok.x.ai/*",
        "https://deepseek.com/*",
        "https://platform.deepseek.com/*",
        "https://qwen.ai/*",
        "https://tongyi.aliyun.com/*",
        "https://kimi.moonshot.ai/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "RememberMyContext"
  },
  "side_panel": {
    "default_path": "popup/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
