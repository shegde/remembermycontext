    "https://huawei.com/*",
    "https://ai21.com/*",
    "https://studio.ai21.com/*",
    "https://stability.ai/*",
    "https://aleph-alpha.com/*",
    "https://reka.ai/*",
    "https://writer.com/*",
    "https://snowflake.com/*",
    "https://databricks.com/*",
    "https://mosaicml.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://poe.com/*",
    "https://character.ai/*",
    "https://you.com/*",
    "https://phind.com/*",
    "https://www.phind.com/*",
    "https://copilot.microsoft.com/*",
    "https://bing.com/*",
    "https://www.bing.com/*"
