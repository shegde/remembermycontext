        "https://poe.com/*",
        "https://character.ai/*",
        "https://you.com/*",
        "https://phind.com/*",
        "https://www.phind.com/*",
        "https://copilot.microsoft.com/*",
        "https://bing.com/*",
        "https://www.bing.com/*"
      ],
      "js": ["content.js"]
    }
