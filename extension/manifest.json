{
  "manifest_version": 3,
  "name": "RememberMyContext",
  "version": "1.0.0",
  "description": "Never repeat your context across LLM apps. Store once, use everywhere.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://remembermycontexttest.onrender.com/*",
    "https://*.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://openai.com/*",
    "https://platform.openai.com/*",
    "https://claude.ai/*",
    "https://chat.anthropic.com/*",
    "https://anthropic.com/*",
    "https://gemini.google.com/*",
    "https://bard.google.com/*",
    "https://deepmind.google/*",
    "https://ai.google.dev/*",
    "https://meta.ai/*",
    "https://llama.meta.com/*",
    "https://x.ai/*",
    "https://grok.x.ai/*",
    "https://mistral.ai/*",
    "https://chat.mistral.ai/*",
    "https://console.mistral.ai/*",
    "https://deepseek.com/*",
    "https://platform.deepseek.com/*",
