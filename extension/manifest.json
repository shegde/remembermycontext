{
  "manifest_version": 3,
  "name": "RememberMyContext",
  "version": "1.0.0",
  "description": "Never repeat your context across LLM apps. Store once, use everywhere.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://remembermycontexttest.onrender.com/*",
    "https://*.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://*.anthropic.com/*",
        "https://*.openai.com/*",
        "https://bard.google.com/*",
        "https://gemini.google.com/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://character.ai/*",
        "https://you.com/*",
        "https://phind.com/*",
        "https://copilot.microsoft.com/*",
        "https://bing.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "RememberMyContext"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
